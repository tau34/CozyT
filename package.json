{
  "name": "cozyt",
  "private": true,
  "version": "0.1.0",
  "description": "A cozy game portal with a Discord bot and web client.",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace @cozyt/web",
    "dev:bot": "npm run dev --workspace @cozyt/bot",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
