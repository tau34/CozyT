{
  "name": "@cozyt/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:production": "tsc -p tsconfig.json --noEmit && vite build --mode production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cozyt/core": "*",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
